{
  "owner": "shinnaluo",
  "branch": "main",
  "tag_pattern": "{repo}-v{version}",
  "exclude": ["**/__pycache__/**", "*.pyc", "**/.DS_Store", "*.log"],
  "targets": [
    {
      "repo": "ha-chuanglvjia",
